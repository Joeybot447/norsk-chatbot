{
  "version": 2,
  "buildCommand": "npm install --workspace=packages/api && npm run build --workspace=packages/api",
  "outputDirectory": "packages/api/dist",
  "env": {
    "NODE_ENV": "production"
  },
  "functions": {
    "packages/api/**": {
      "memory": 1024,
      "maxDuration": 60
    }
  }
}
