# ===== API SERVER =====
NODE_ENV=development
PORT=3000
API_URL=http://localhost:3000
WIDGET_URL=http://localhost:5173

# ===== DATABASE =====
DATABASE_URL=postgresql://user:password@localhost:5432/norsk_chatbot
REDIS_URL=redis://localhost:6379

# ===== AUTHENTICATION =====
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-long-here
JWT_EXPIRATION=3600

# ===== LLM PROVIDERS =====
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-... # For fallback model

# ===== EMBEDDINGS =====
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ===== EXTERNAL SERVICES =====
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ===== EMAIL =====
MAILJET_API_KEY=...
MAILJET_API_SECRET=...
SUPPORT_EMAIL=support@norsk-chatbot.no

# ===== WEBSITE CRAWLING =====
MAX_PAGES_PER_CRAWL=1000
CRAWL_TIMEOUT_SECONDS=10
CRAWL_DELAY_MILLISECONDS=1000

# ===== VECTOR DB =====
PGVECTOR_ENABLED=true

# ===== LOGGING & MONITORING =====
SENTRY_DSN=https://...
LOG_LEVEL=info

# ===== ADMIN =====
ADMIN_EMAIL=admin@norsk-chatbot.no
ADMIN_PASSWORD=change-me-in-production
