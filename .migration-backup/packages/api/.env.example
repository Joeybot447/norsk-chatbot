# ===== API SERVER =====
NODE_ENV=development
PORT=3000
API_URL=http://localhost:3000

# ===== DATABASE =====
DATABASE_URL=postgresql://norsk_chatbot:password@localhost:5432/norsk_chatbot
REDIS_URL=redis://localhost:6379

# ===== AUTHENTICATION =====
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-long-here
JWT_EXPIRATION=3600

# ===== LLM PROVIDERS =====
ANTHROPIC_API_KEY=sk-ant-xxxxx
OPENAI_API_KEY=sk-xxxxx

# ===== STRIPE =====
STRIPE_SECRET_KEY=sk_test_xxxxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxx

# ===== EMAIL =====
MAILJET_API_KEY=xxxxx
MAILJET_API_SECRET=xxxxx
SUPPORT_EMAIL=support@norsk-chatbot.no

# ===== WEBSITE CRAWLING =====
MAX_PAGES_PER_CRAWL=1000
CRAWL_TIMEOUT_SECONDS=10
CRAWL_DELAY_MILLISECONDS=1000

# ===== LOGGING =====
LOG_LEVEL=info
SENTRY_DSN=https://xxxxx

# ===== WIDGET =====
WIDGET_CDN_URL=https://api.norsk-chatbot.no/widget.js
